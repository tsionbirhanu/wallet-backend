# Required. PostgreSQL connection string, for example Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

# Required. Long random secret used to sign admin and customer JWTs.
JWT_SECRET=replace-me-with-a-long-random-secret

# Required for local/demo server start. Render also injects PORT.
PORT=4000

# Recommended. Use production in deploys, development locally.
NODE_ENV=development

# Optional. Comma-separated frontend origins allowed by browser CORS.
# Example: https://your-admin-frontend.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Optional. Defaults to 20 login attempts per 15 minutes per IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Optional. Defaults to 30 OTP-sensitive requests per 10 minutes per IP.
OTP_RATE_LIMIT_MAX=30
OTP_RATE_LIMIT_WINDOW_MINUTES=10

# Optional. Use mock for local logs, or smsethiopia for the SMS Ethiopia provider.
SMS_PROVIDER=mock

# Required when SMS_PROVIDER=smsethiopia. Create this from https://smsethiopia.com/#/api-keys.
SMSETHIOPIA_API_KEY=replace-with-your-smsethiopia-api-key

# Required when SMS_PROVIDER=smsethiopia if your campaign/API key requires a sender or campaign ID.
SMSETHIOPIA_SENDER_ID=replace-with-your-approved-sender-or-campaign

# Optional. SMS Ethiopia API base URL. Do not use plain HTTP.
SMSETHIOPIA_BASE_URL=https://smsethiopia.com/api

# Optional. Use v2 for real message IDs; v1 is also supported.
SMSETHIOPIA_API_VERSION=v2

# Optional. Defaults to mock. Real FCM is enabled when Firebase service account env is set.
PUSH_PROVIDER=mock

# Optional. Paste the full Firebase service account JSON on one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional. Alternative to FIREBASE_SERVICE_ACCOUNT_JSON.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service-account.json
